PROJECT_NAME="Advertising Automation API"
ENVIRONMENT=production
API_V1_PREFIX=/api/v1

# PostgreSQL used by docker-compose.prod.yml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=ad_automation

SECRET_KEY=change-this-secret-key

# Shared token required by protected /api/v1 business endpoints.
AI_ADS_ACCESS_TOKEN=change-this-ai-ads-access-token

# Default browser return URL after final confirmation. A job-level return_url overrides this.
AI_ADS_RETURN_URL=https://ads.ggcss.xyz/api/ai/receive_ai_ads

# Use your real public domain or temporary tunnel URL.
CORS_ORIGINS=https://ai.example.com
PUBLIC_BASE_URL=https://ai.example.com
AD_GENERATION_REVIEW_BASE_URL=https://ai.example.com
WEB_HTTP_PORT=80

# The production frontend is served by Nginx in the same compose stack.
VITE_API_BASE_URL=/api/v1

# Text provider options: openai, volcengine. Production usually uses volcengine here.
LLM_PROVIDER=volcengine
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Volcengine Ark / Doubao settings.
ARK_API_KEY=
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_MODEL=your-ark-text-endpoint-id
VOLCENGINE_IMAGE_MODEL=doubao-seedream-4-5-251128
VOLCENGINE_IMAGE_SIZE=2K
VOLCENGINE_IMAGE_WATERMARK=false

# Video generation. Leave VOLCENGINE_VIDEO_API_KEY empty to reuse VOLCENGINE_API_KEY.
VOLCENGINE_VIDEO_API_KEY=
VOLCENGINE_VIDEO_MODEL=your-seedance-endpoint-id
VOLCENGINE_VIDEO_RESOLUTION=720p
VOLCENGINE_VIDEO_IMAGE_MODE=first_last_frame
VOLCENGINE_VIDEO_MIN_DURATION_SECONDS=4
VOLCENGINE_VIDEO_MAX_DURATION_SECONDS=12
VOLCENGINE_VIDEO_MAX_REFERENCE_IMAGES=2
VOLCENGINE_VIDEO_GENERATE_AUDIO=false
VOLCENGINE_VIDEO_WATERMARK=false
VOLCENGINE_VIDEO_RETURN_LAST_FRAME=false
VOLCENGINE_VIDEO_EXECUTION_EXPIRES_AFTER=172800
VOLCENGINE_VIDEO_PRIORITY=0
VOLCENGINE_VIDEO_SAFETY_IDENTIFIER=

IMAGE_PROVIDER=volcengine
VIDEO_PROVIDER=volcengine

# Currently implemented persisted asset storage: local server disk.
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=/data/storage
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=60
IMAGE_DOWNLOAD_MAX_BYTES=26214400
VIDEO_DOWNLOAD_TIMEOUT_SECONDS=120
VIDEO_DOWNLOAD_MAX_BYTES=524288000
