PROJECT_NAME="Advertising Automation API"
ENVIRONMENT=production
API_V1_PREFIX=/api/v1

# PostgreSQL used by docker-compose.prod.yml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=ad_automation

SECRET_KEY=change-this-secret-key

# Shared token required by protected /api/v1 business endpoints.
AI_ADS_ACCESS_TOKEN=change-this-ai-ads-access-token

# Default browser return URL after final confirmation. A job-level return_url overrides this.
AI_ADS_RETURN_URL=https://ads.ggcss.xyz/api/ai/receive_ai_ads

# Use the public AI system domain in production.
CORS_ORIGINS=https://ai.ggcss.xyz,https://newpixel.messrocts.com
PUBLIC_BASE_URL=https://ai.ggcss.xyz
AD_GENERATION_REVIEW_BASE_URL=https://ai.ggcss.xyz
WEB_HTTP_PORT=80

# The production frontend is served by Nginx in the same compose stack.
VITE_API_BASE_URL=/api/v1

# Generation task queue capacity. Tune these after pressure testing.
GENERATION_TASK_EXECUTION_BACKEND=celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Redis lease store shared by all ad-research model workers.
REDIS_URL=redis://redis:6379/2
TEXT_QUEUE_CONCURRENCY=6
IMAGE_QUEUE_CONCURRENCY=4
EXTERNAL_IMAGE_GENERATION_MAX_ATTEMPTS=3
# Optional external image routing: fixed or round_robin. CPA Gemini is text-to-image only.
EXTERNAL_IMAGE_ROUTE_MODE=fixed
EXTERNAL_IMAGE_ROUTE_PROVIDERS=gateway,volcengine,cpa_gemini
# Text LLM limiter now covers internal synchronous calls and external AI jobs.
# Raise these together with gateway capacity; streaming calls hold inflight until done.
LLM_TEXT_RPM_LIMIT=60
LLM_TEXT_MAX_INFLIGHT=16
MODEL_PROVIDER_IMAGE_CONCURRENCY=6
VIDEO_QUEUE_CONCURRENCY=4
CALLBACK_QUEUE_CONCURRENCY=3
AD_ANALYSIS_QUEUE_CONCURRENCY=2
MODEL_PROVIDER_AD_ANALYSIS_CONCURRENCY=2

# Public Meta Ad Library research (internal collector bridge; no external callback).
AD_RESEARCH_WORKER_CONCURRENCY=2
AD_RESEARCH_MODEL_CONCURRENCY=6
AD_RESEARCH_MODEL=gpt-5.4-mini
AD_RESEARCH_MODEL_TIMEOUT_SECONDS=45
AD_RESEARCH_MODEL_LEASE_SECONDS=90
AD_RESEARCH_COLLECTOR_BASE_URL=http://meta_ads_collector:8090
AD_RESEARCH_COLLECTOR_TIMEOUT_SECONDS=120
# Optional Collector build mirror hostname. Used only while Docker builds meta_ads_collector.
META_ADS_APT_MIRROR_HOST=mirrors.aliyun.com
GENERATION_TASK_TARGET_CONCURRENT_USERS=30

# Text provider options: openai, volcengine, gateway.
LLM_PROVIDER=volcengine
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=

# OpenAI-compatible local model gateway for text and image generation.
# Use LLM_PROVIDER=gateway and IMAGE_PROVIDER=gateway to route through it.
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_BASE_URL=http://127.0.0.1:3000/v1
MODEL_GATEWAY_TEXT_MODEL=
MODEL_GATEWAY_TEXT_TIMEOUT_SECONDS=180
MODEL_GATEWAY_TEXT_FAST_TIMEOUT_SECONDS=45
MODEL_GATEWAY_IMAGE_TIMEOUT_SECONDS=300
MODEL_GATEWAY_IMAGE_MODEL=
# Gemini image route uses the same MODEL_GATEWAY_API_KEY and MODEL_GATEWAY_BASE_URL.
MODEL_GATEWAY_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Optional comma-separated lists shown in frontend model dropdowns.
MODEL_GATEWAY_TEXT_MODELS=
MODEL_GATEWAY_IMAGE_MODELS=
MODEL_GATEWAY_IMAGE_SIZE=1024x1024
# Optional. Leave empty unless the gateway requires url or b64_json.
MODEL_GATEWAY_IMAGE_RESPONSE_FORMAT=
# Gateway image edits are enabled for supported models. Set false to force prompt fallback.
MODEL_GATEWAY_IMAGE_EDIT_ENABLED=true
MODEL_GATEWAY_IMAGE_EDIT_PATH=/images/edits
# Optional. Leave empty to reuse MODEL_GATEWAY_IMAGE_MODEL for edits.
MODEL_GATEWAY_IMAGE_EDIT_MODEL=

# Volcengine Ark / Doubao settings.
ARK_API_KEY=
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_MODEL=your-ark-text-endpoint-id
VOLCENGINE_IMAGE_MODEL=doubao-seedream-4-5-251128
VOLCENGINE_IMAGE_SIZE=2K
VOLCENGINE_IMAGE_WATERMARK=false

# Video generation. Leave VOLCENGINE_VIDEO_API_KEY empty to reuse VOLCENGINE_API_KEY.
VOLCENGINE_VIDEO_API_KEY=
VOLCENGINE_VIDEO_MODEL=your-seedance-endpoint-id
VOLCENGINE_VIDEO_RESOLUTION=480p
VOLCENGINE_VIDEO_IMAGE_MODE=first_last_frame
VOLCENGINE_VIDEO_MIN_DURATION_SECONDS=4
VOLCENGINE_VIDEO_MAX_DURATION_SECONDS=12
VOLCENGINE_VIDEO_MAX_REFERENCE_IMAGES=2
VOLCENGINE_VIDEO_GENERATE_AUDIO=true
VOLCENGINE_VIDEO_WATERMARK=false
VOLCENGINE_VIDEO_RETURN_LAST_FRAME=false
VOLCENGINE_VIDEO_TIMEOUT_SECONDS=180
VOLCENGINE_VIDEO_EXECUTION_EXPIRES_AFTER=172800
VOLCENGINE_VIDEO_PRIORITY=0
VOLCENGINE_VIDEO_SAFETY_IDENTIFIER=

# IMAGE_PROVIDER options: volcengine, gateway, cpa_gemini.
IMAGE_PROVIDER=volcengine
VIDEO_PROVIDER=volcengine

# Currently implemented persisted asset storage: local server disk.
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=/data/storage
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=60
IMAGE_DOWNLOAD_MAX_BYTES=26214400
VIDEO_DOWNLOAD_TIMEOUT_SECONDS=120
VIDEO_DOWNLOAD_MAX_BYTES=524288000

# External Facebook ad-performance analysis jobs.
AD_ANALYSIS_MEDIA_ROOT=/data/ad-analysis-media
AD_ANALYSIS_MEDIA_PROCESSING_ENABLED=true
AD_ANALYSIS_ALLOW_PRIVATE_MEDIA_HOSTS=false
AD_ANALYSIS_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=20
AD_ANALYSIS_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=30
AD_ANALYSIS_VIDEO_DOWNLOAD_TIMEOUT_SECONDS=80
AD_ANALYSIS_MEDIA_DOWNLOAD_RETRY_ATTEMPTS=1
AD_ANALYSIS_MEDIA_DOWNLOAD_RETRY_DELAY_SECONDS=1
AD_ANALYSIS_FFPROBE_TIMEOUT_SECONDS=10
AD_ANALYSIS_FFMPEG_FRAME_TIMEOUT_SECONDS=15
AD_ANALYSIS_IMAGE_DOWNLOAD_MAX_BYTES=26214400
AD_ANALYSIS_VIDEO_MAX_DURATION_SECONDS=20
AD_ANALYSIS_VIDEO_DOWNLOAD_MAX_BYTES=104857600
AD_ANALYSIS_PUBLIC_RESEARCH_ENABLED=true
PUBLIC_RESEARCH_ENABLED=true
AD_ANALYSIS_PUBLIC_RESEARCH_TIMEOUT_SECONDS=6
AD_ANALYSIS_PUBLIC_RESEARCH_MAX_RESULTS=3
