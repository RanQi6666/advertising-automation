PROJECT_NAME="Advertising Automation API"
ENVIRONMENT=local
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/ad_automation
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/ad_automation
CREATE_DB_ON_STARTUP=false

SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Options: mock, openai, volcengine
LLM_PROVIDER=mock
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Volcengine Ark OpenAI-compatible LLM.
# After filling VOLCENGINE_API_KEY, set LLM_PROVIDER=volcengine to enable it.
ARK_API_KEY=
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_MODEL=doubao-seed-1-8-251228
VOLCENGINE_IMAGE_MODEL=doubao-seedream-4-5-251128
VOLCENGINE_IMAGE_SIZE=2K
VOLCENGINE_IMAGE_WATERMARK=false
VOLCENGINE_VIDEO_API_KEY=
VOLCENGINE_VIDEO_MODEL=your-seedance-endpoint-id
VOLCENGINE_VIDEO_RESOLUTION=720p
VOLCENGINE_VIDEO_IMAGE_MODE=first_last_frame
VOLCENGINE_VIDEO_MIN_DURATION_SECONDS=4
VOLCENGINE_VIDEO_MAX_DURATION_SECONDS=12
VOLCENGINE_VIDEO_MAX_REFERENCE_IMAGES=2
VOLCENGINE_VIDEO_GENERATE_AUDIO=false
VOLCENGINE_VIDEO_WATERMARK=false
VOLCENGINE_VIDEO_RETURN_LAST_FRAME=false
VOLCENGINE_VIDEO_EXECUTION_EXPIRES_AFTER=172800
VOLCENGINE_VIDEO_PRIORITY=0
VOLCENGINE_VIDEO_SAFETY_IDENTIFIER=

# Options: placeholder, volcengine
IMAGE_PROVIDER=placeholder
VIDEO_PROVIDER=placeholder
OBJECT_STORAGE_PROVIDER=local
PUBLIC_BASE_URL=http://127.0.0.1:8001
LOCAL_STORAGE_ROOT=storage
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=60
IMAGE_DOWNLOAD_MAX_BYTES=26214400
VIDEO_DOWNLOAD_TIMEOUT_SECONDS=120
VIDEO_DOWNLOAD_MAX_BYTES=524288000

FACEBOOK_DRY_RUN=true
FACEBOOK_ADS_DRY_RUN=true
FACEBOOK_GRAPH_API_BASE_URL=https://graph.facebook.com
FACEBOOK_GRAPH_API_VERSION=v24.0
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_AD_ACCOUNT_ID=
FACEBOOK_AD_ACCESS_TOKEN=
FACEBOOK_OAUTH_REDIRECT_URI=http://127.0.0.1:8001/api/v1/meta-oauth/callback
FACEBOOK_OAUTH_SUCCESS_REDIRECT_URL=http://127.0.0.1:5173/?view=publishing&meta_oauth=success
FACEBOOK_LOGIN_CONFIG_ID=
FACEBOOK_OAUTH_SCOPES=ads_management,ads_read,business_management,pages_show_list,pages_read_engagement

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
