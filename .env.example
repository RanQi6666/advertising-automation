PROJECT_NAME="Advertising Automation API"
ENVIRONMENT=local
API_V1_PREFIX=/api/v1

# Local PostgreSQL from infra/docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/ad_automation
CREATE_DB_ON_STARTUP=false

SECRET_KEY=change-me-in-production

# Leave empty locally to disable API token checks.
# Set a shared token to require Authorization: Bearer <token> or ?access_token=<token>.
AI_ADS_ACCESS_TOKEN=

# Default browser return URL after final confirmation. A job-level return_url overrides this.
AI_ADS_RETURN_URL=

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=http://127.0.0.1:8001
AD_GENERATION_REVIEW_BASE_URL=http://127.0.0.1:5173

# Text provider options: mock, openai, volcengine, gateway.
LLM_PROVIDER=mock
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=

# OpenAI-compatible local model gateway for text and image generation.
# Use LLM_PROVIDER=gateway and IMAGE_PROVIDER=gateway to route through it.
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_BASE_URL=http://127.0.0.1:3000/v1
MODEL_GATEWAY_TEXT_MODEL=
MODEL_GATEWAY_TEXT_TIMEOUT_SECONDS=180
MODEL_GATEWAY_TEXT_FAST_TIMEOUT_SECONDS=45
MODEL_GATEWAY_IMAGE_TIMEOUT_SECONDS=300
GENERATION_TASK_EXECUTION_BACKEND=background_tasks
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
TEXT_QUEUE_CONCURRENCY=6
IMAGE_QUEUE_CONCURRENCY=4
EXTERNAL_IMAGE_GENERATION_MAX_ATTEMPTS=3
# Text LLM limiter now covers internal synchronous calls and external AI jobs.
# Raise these together with gateway capacity; streaming calls hold inflight until done.
LLM_TEXT_RPM_LIMIT=60
LLM_TEXT_MAX_INFLIGHT=16
MODEL_PROVIDER_IMAGE_CONCURRENCY=6
VIDEO_QUEUE_CONCURRENCY=4
CALLBACK_QUEUE_CONCURRENCY=3
GENERATION_TASK_TARGET_CONCURRENT_USERS=30
GENERATION_TASK_RECOVERY_ENABLED=true
GENERATION_TASK_RECOVERY_INTERVAL_SECONDS=60
GENERATION_TASK_QUEUED_STALE_SECONDS=60
GENERATION_TASK_RUNNING_STALE_SECONDS=1800
MODEL_GATEWAY_IMAGE_MODEL=
# Optional comma-separated lists shown in frontend model dropdowns.
MODEL_GATEWAY_TEXT_MODELS=
MODEL_GATEWAY_IMAGE_MODELS=
MODEL_GATEWAY_IMAGE_SIZE=1024x1024
# Optional. Leave empty unless the gateway requires url or b64_json.
MODEL_GATEWAY_IMAGE_RESPONSE_FORMAT=
MODEL_GATEWAY_IMAGE_EDIT_ENABLED=false
MODEL_GATEWAY_IMAGE_EDIT_PATH=/images/edits
# Optional. Leave empty to reuse MODEL_GATEWAY_IMAGE_MODEL for edits.
MODEL_GATEWAY_IMAGE_EDIT_MODEL=

# Volcengine Ark / Doubao settings.
# For real generation, set LLM_PROVIDER=volcengine and fill VOLCENGINE_API_KEY.
ARK_API_KEY=
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_MODEL=your-ark-text-endpoint-id
VOLCENGINE_IMAGE_MODEL=doubao-seedream-4-5-251128
VOLCENGINE_IMAGE_SIZE=2K
VOLCENGINE_IMAGE_WATERMARK=false

# Video generation. Leave VOLCENGINE_VIDEO_API_KEY empty to reuse VOLCENGINE_API_KEY.
VOLCENGINE_VIDEO_API_KEY=
VOLCENGINE_VIDEO_MODEL=your-seedance-endpoint-id
VOLCENGINE_VIDEO_RESOLUTION=720p
VOLCENGINE_VIDEO_IMAGE_MODE=first_last_frame
VOLCENGINE_VIDEO_MIN_DURATION_SECONDS=4
VOLCENGINE_VIDEO_MAX_DURATION_SECONDS=12
VOLCENGINE_VIDEO_MAX_REFERENCE_IMAGES=2
VOLCENGINE_VIDEO_GENERATE_AUDIO=true
VOLCENGINE_VIDEO_WATERMARK=false
VOLCENGINE_VIDEO_RETURN_LAST_FRAME=false
VOLCENGINE_VIDEO_TIMEOUT_SECONDS=60
VOLCENGINE_VIDEO_EXECUTION_EXPIRES_AFTER=172800
VOLCENGINE_VIDEO_PRIORITY=0
VOLCENGINE_VIDEO_SAFETY_IDENTIFIER=

# Local-safe provider options: placeholder.
# Real provider options: volcengine, gateway.
IMAGE_PROVIDER=placeholder
VIDEO_PROVIDER=placeholder

# Currently implemented persisted asset storage: local.
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=storage
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=60
IMAGE_DOWNLOAD_MAX_BYTES=26214400
VIDEO_DOWNLOAD_TIMEOUT_SECONDS=120
VIDEO_DOWNLOAD_MAX_BYTES=524288000
