PROJECT_NAME="Advertising Automation API"
ENVIRONMENT=local
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ad_automation
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ad_automation
CREATE_DB_ON_STARTUP=false

SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

LLM_PROVIDER=mock
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

IMAGE_PROVIDER=placeholder
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=storage

FACEBOOK_DRY_RUN=true
FACEBOOK_GRAPH_API_BASE_URL=https://graph.facebook.com
FACEBOOK_GRAPH_API_VERSION=v24.0

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
